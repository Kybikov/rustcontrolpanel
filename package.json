{
  "name": "rust-control",
  "private": true,
  "version": "0.1.10",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "release:check": "node scripts/check-changelog.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "check": "npm run release:check && npm run typecheck:web && npm run lint:web && npm run build:web"
  }
}
