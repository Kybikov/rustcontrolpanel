# Paste these KEY=value lines into the RUST_CONTROL_CONFIG environment variable
# in the deployment panel. Docker Compose mounts it only inside the API container.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-long-unique-password
INTEGRATIONS_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-secret
STEAM_WEB_API_KEY=replace-with-your-steam-web-api-key

# Optional. Leave BattleMetrics absent until a token is available.
# BATTLEMETRICS_API_TOKEN=replace-with-battlemetrics-token

# Optional. Required only for browser push notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
