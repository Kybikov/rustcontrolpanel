APP_ENV=development
POSTGRES_DB=rustcontrol
POSTGRES_USER=rustcontrol
POSTGRES_PASSWORD=rustcontrol
DATABASE_URL=postgres://rustcontrol:rustcontrol@postgres:5432/rustcontrol?sslmode=disable
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_HOST_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/api/v1/realtime/ws
NEXT_PUBLIC_API_URL=http://localhost:8080
SUPERADMIN_EMAIL=admin@rustcontrol.local
SUPERADMIN_PASSWORD=change-this-before-starting
